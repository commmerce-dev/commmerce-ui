{
  "name": "@commmerce/ui",
  "version": "1.20.3",
  "description": "Commmerce UI web components: build apps that feel native to the Commmerce admin. Works in plain HTML, React, Vue and server-rendered pages.",
  "keywords": [
    "web-components",
    "custom-elements",
    "lit",
    "commmerce",
    "design-system",
    "ui"
  ],
  "author": "Commmerce",
  "homepage": "https://commmerce.com/commmerceui/",
  "bugs": {
    "email": "support@commmerce.com"
  },
  "license": "SEE LICENSE IN LICENSE.md",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/commmerce-dev/commmerce-ui.git",
    "directory": "packages/ui"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./cdn.js": "./dist/cdn.js",
    "./components/*": {
      "types": "./dist/components/*.d.ts",
      "default": "./dist/components/*.js"
    }
  },
  "files": [
    "dist",
    "LICENSE.md",
    "THIRD_PARTY_NOTICES.txt",
    "README.md"
  ],
  "sideEffects": [
    "./dist/index.js",
    "./dist/cdn.js",
    "./dist/components/accordion.js",
    "./dist/components/account-menu.js",
    "./dist/components/action-bar.js",
    "./dist/components/action-menu.js",
    "./dist/components/app-card.js",
    "./dist/components/app-frame.js",
    "./dist/components/avatar.js",
    "./dist/components/badge.js",
    "./dist/components/banner.js",
    "./dist/components/board.js",
    "./dist/components/bottom-navigation.js",
    "./dist/components/bottom-sheet.js",
    "./dist/components/button-group.js",
    "./dist/components/button.js",
    "./dist/components/calendar.js",
    "./dist/components/card.js",
    "./dist/components/checkbox.js",
    "./dist/components/color-field.js",
    "./dist/components/color-picker.js",
    "./dist/components/combobox.js",
    "./dist/components/command-palette.js",
    "./dist/components/comment.js",
    "./dist/components/data-table.js",
    "./dist/components/date-picker.js",
    "./dist/components/date-range-picker.js",
    "./dist/components/empty-state.js",
    "./dist/components/file-upload.js",
    "./dist/components/filter-panel.js",
    "./dist/components/flash-offer-bar.js",
    "./dist/components/global-search.js",
    "./dist/components/grid.js",
    "./dist/components/header-bar.js",
    "./dist/components/icon.js",
    "./dist/components/info-panel.js",
    "./dist/components/layout.js",
    "./dist/components/link-tabs.js",
    "./dist/components/menu-item.js",
    "./dist/components/metric.js",
    "./dist/components/mobile-menu.js",
    "./dist/components/modal.js",
    "./dist/components/nav-item.js",
    "./dist/components/nested-list.js",
    "./dist/components/notification-panel.js",
    "./dist/components/option-group.js",
    "./dist/components/page-header.js",
    "./dist/components/page.js",
    "./dist/components/pagination.js",
    "./dist/components/progress-bar.js",
    "./dist/components/radio.js",
    "./dist/components/report-tile.js",
    "./dist/components/resource-list.js",
    "./dist/components/save-bar.js",
    "./dist/components/search.js",
    "./dist/components/segmented-control.js",
    "./dist/components/select.js",
    "./dist/components/side-navigation.js",
    "./dist/components/side-panel.js",
    "./dist/components/signature-field.js",
    "./dist/components/skeleton-display.js",
    "./dist/components/skeleton.js",
    "./dist/components/smart-tip.js",
    "./dist/components/sparkline.js",
    "./dist/components/spinner.js",
    "./dist/components/stack.js",
    "./dist/components/status-tabs.js",
    "./dist/components/table-header.js",
    "./dist/components/tag.js",
    "./dist/components/text-field.js",
    "./dist/components/thumbnail.js",
    "./dist/components/time-picker.js",
    "./dist/components/timeline.js",
    "./dist/components/toast.js",
    "./dist/components/toggle.js",
    "./dist/components/tooltip.js"
  ],
  "customElements": "dist/custom-elements.json",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node ../../scripts/sync-side-effects.mjs && tsc -p tsconfig.json && esbuild src/index.ts --bundle --minify --format=esm --target=es2021 --outfile=dist/cdn.js && cem analyze --litelement --globs \"src/components/*.ts\" \"src/localize.ts\" \"src/overlay.ts\" --outdir dist",
    "test": "vitest run"
  },
  "dependencies": {
    "@commmerce/icons": "1.20.3",
    "@commmerce/tokens": "1.20.3",
    "lit": "3.2.1"
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "^0.10.3",
    "@vitest/browser-playwright": "4.1.12",
    "playwright": "1.64.1"
  }
}
