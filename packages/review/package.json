{
  "name": "@commmerce/review",
  "version": "1.21.0",
  "description": "Review what you build with Commmerce UI from your coding agent or CI: component lookup, local page checks and design reviews by Commmerce, as a CLI and an MCP server.",
  "keywords": [
    "commmerce",
    "mcp",
    "design-review",
    "accessibility",
    "cli"
  ],
  "author": "Commmerce",
  "homepage": "https://commmerce.com/commmerceui/#apps--review",
  "bugs": {
    "url": "https://commmerce.com/commmerceui/#apps--feedback"
  },
  "license": "SEE LICENSE IN LICENSE.md",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/commmerce-dev/commmerce-ui.git",
    "directory": "packages/review"
  },
  "type": "module",
  "bin": {
    "commmerce-review": "bin/commmerce-review.mjs"
  },
  "exports": {
    ".": "./lib/index.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "lib",
    "dist",
    "LICENSE.md",
    "README.md"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build-components.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "axe-core": "4.10.2"
  },
  "peerDependencies": {
    "playwright": ">=1.40.0"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "playwright": "1.64.1"
  }
}
