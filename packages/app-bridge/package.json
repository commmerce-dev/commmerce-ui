{
  "name": "@commmerce/app-bridge",
  "version": "1.21.0",
  "description": "Connects an app embedded in the Commmerce admin to the admin: toasts, modals, navigation, save bar, resource picker, loading bar and session tokens.",
  "keywords": [
    "commmerce",
    "app-bridge",
    "postmessage",
    "iframe",
    "embedded-app"
  ],
  "author": "Commmerce",
  "homepage": "https://commmerce.com/commmerceui/",
  "bugs": {
    "email": "support@commmerce.com"
  },
  "license": "SEE LICENSE IN LICENSE.md",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/commmerce-dev/commmerce-ui.git",
    "directory": "packages/app-bridge"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./session-token": {
      "types": "./dist/session-token.d.ts",
      "default": "./dist/session-token.js"
    },
    "./app-bridge.js": "./dist/app-bridge.js"
  },
  "files": [
    "dist",
    "LICENSE.md",
    "README.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && esbuild src/index.ts --bundle --minify --format=esm --target=es2021 --outfile=dist/app-bridge.js",
    "test": "vitest run"
  },
  "devDependencies": {
    "@commmerce/ui": "1.21.0",
    "@vitest/browser-playwright": "4.1.12",
    "playwright": "1.64.1"
  }
}
